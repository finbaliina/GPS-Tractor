# Mapbox
MAPBOX_TOKEN=pk.your_token_here
MAP_ZOOM=16
IMAGE_WIDTH=1000
IMAGE_HEIGHT=1000

# GPS
GPS_MODE=mock
MOCK_LAT=55.556232
MOCK_LON=-2.689174
GPS_PORT=/dev/serial0
GPS_BAUD=115200
GPS_SAMPLES=5
GPS_TIMEOUT=300
GPS_ALLOW_FLOAT=false

# Image review and field detection
REVIEW_IMAGE=true
SAM_MODEL=facebook/sam2.1-hiera-tiny
BOUNDARY_SIMPLIFY=0.005

# Farm setup overview
FARM_OVERVIEW_RADIUS_M=6500
FARM_OVERVIEW_WIDTH=1200
FARM_OVERVIEW_HEIGHT=900

# Automatic field discovery
FIELD_DISCOVERY_MPP=0.8
FIELD_DISCOVERY_IMAGE_SIZE=1000
FIELD_DISCOVERY_TILE_OVERLAP=0.12
FIELD_DISCOVERY_CONTEXT_BUFFER_M=120
FIELD_DISCOVERY_MAX_TILES=180
FIELD_DISCOVERY_PROMPT_SPACING_M=120
FIELD_DISCOVERY_MIN_SAM_SCORE=0.60
FIELD_DISCOVERY_SIMPLIFY_M=2.0
FIELD_DISCOVERY_MIN_AREA_OVERLAP=0.35
FIELD_MIN_AREA_HA=0.35
FIELD_MAX_AREA_HA=250
FIELD_DEDUP_IOU=0.55

# Tractor and route
TRACTOR_PROFILE=default_tractor
IMPLEMENT_WIDTH_M=6.0
HEADLAND_WIDTH_M=1.0
OVERLAP=0.02
ANGLE_STEP_DEG=2
WORKING_SPEED_MPS=2.5
TURNING_SPEED_MPS=1.5
FIXED_TURN_TIME_S=2

# Terrain and contour-aware straight routing
AUTO_FETCH_TERRAIN=true
TERRAIN_TILE_ZOOM=14
TERRAIN_GRID_SIZE=300
CONTOUR_INTERVAL_M=2.0
CONTOUR_SLOPE_THRESHOLD_DEG=5.0
TERRAIN_REQUEST_TIMEOUT=30
CONTOUR_STRAIGHT_ANGLE_STEP_DEG=1.0
CONTOUR_ALIGNMENT_WEIGHT=8.0
CONTOUR_DIRECTION_MIN_SLOPE_DEG=1.0
CONTOUR_EXTRA_OVERLAP=0.08

# Local UI
GPS_TRACTOR_UI_PORT=5000
GPS_TRACTOR_OPEN_BROWSER=true
