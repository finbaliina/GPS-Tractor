# =============================================================================
# GPS TRACTOR CONFIGURATION
# =============================================================================
# All tuneable runtime parameters live here. The Python code reads them through
# settings.py, so there should be no duplicated defaults hidden inside functions.
#
# Units are included in parameter names where practical:
#   _M     metres
#   _MPS   metres per second
#   _S     seconds
#   _PX    pixels
#   _DEG   degrees
#   _HA    hectares
#   _BGR   OpenCV colour in blue,green,red order
# =============================================================================


# -----------------------------------------------------------------------------
# Mapbox / satellite imagery
# -----------------------------------------------------------------------------

# Your Mapbox public access token. Keep the real token in .env, not in git.
MAPBOX_TOKEN=pk.your_token_here

# Mapbox style used for all static satellite images.
# Format is owner/style-id, as used by the Mapbox Static Images API.
MAPBOX_SATELLITE_STYLE=mapbox/satellite-v9

# HTTP timeout for static satellite-image requests.
MAPBOX_REQUEST_TIMEOUT_S=45

# HTTP timeout for Mapbox forward-geocoding requests.
MAPBOX_GEOCODE_TIMEOUT_S=30

# ISO country code passed to Mapbox geocoding to keep farm searches in Britain.
MAPBOX_GEOCODE_COUNTRY=gb

# Zoom used by the single-position capture workflow in main.py.
# Higher values show a smaller area in greater detail.
MAP_ZOOM=16

# Width of the single-position satellite capture.
IMAGE_WIDTH=1000

# Height of the single-position satellite capture.
IMAGE_HEIGHT=1000


# -----------------------------------------------------------------------------
# GPS / RTK
# -----------------------------------------------------------------------------

# GPS source: "mock" for development or "rtk" for the serial RTK receiver.
GPS_MODE=mock

# Latitude used when GPS_MODE=mock.
MOCK_LAT=55.556232

# Longitude used when GPS_MODE=mock.
MOCK_LON=-2.689174

# Serial device used when GPS_MODE=rtk.
GPS_PORT=/dev/serial0

# Serial baud rate for NMEA data from the RTK receiver.
GPS_BAUD=115200

# Number of consecutive acceptable RTK fixes required before position is accepted.
GPS_SAMPLES=5

# Maximum time to wait for a stable RTK position before failing.
GPS_TIMEOUT=300

# Per-read serial timeout while waiting for the next NMEA sentence.
GPS_SERIAL_READ_TIMEOUT_S=1

# If true, accept RTK-float fixes as well as RTK-fixed fixes.
GPS_ALLOW_FLOAT=false


# -----------------------------------------------------------------------------
# Single-field image review and SAM detection
# -----------------------------------------------------------------------------

# If true, the desktop capture workflow shows the downloaded image for approval.
REVIEW_IMAGE=true

# Maximum displayed width of the image-review preview window.
REVIEW_IMAGE_MAX_WIDTH_PX=1000

# Maximum displayed height of the image-review preview window.
REVIEW_IMAGE_MAX_HEIGHT_PX=650

# Hugging Face SAM2 model used by both single-field and whole-farm detection.
# "small" is slower than "tiny" but has been giving better field segmentation.
SAM_MODEL=facebook/sam2.1-hiera-small

# Fraction of the detected contour perimeter used by the legacy single-field
# cv2.approxPolyDP simplifier. Lower values preserve more boundary detail.
BOUNDARY_SIMPLIFY=0.005


# -----------------------------------------------------------------------------
# Farm setup overview
# -----------------------------------------------------------------------------

# Approximate radius shown around the geocoded farm location during setup.
# The displayed image therefore covers roughly twice this distance across.
FARM_OVERVIEW_RADIUS_M=6500

# Width of the zoomed-out farm-selection image.
FARM_OVERVIEW_WIDTH=1200

# Height of the zoomed-out farm-selection image.
FARM_OVERVIEW_HEIGHT=900

# Ignore farm-selection rectangles smaller than this in either dimension.
# This prevents an accidental click/tiny drag from becoming a search area.
FARM_SELECTION_MIN_BOX_SIZE_PX=8


# -----------------------------------------------------------------------------
# Two-stage whole-area field discovery and per-field refinement
# -----------------------------------------------------------------------------

# Stage 1 uses ONE image for each farmer-selected search-area polygon.
# These are Mapbox Static Images, so keep each dimension at or below 1280 px.
DISCOVERY_IMAGE_WIDTH=1200
DISCOVERY_IMAGE_HEIGHT=1200

# Extra real-world context around the selected search box in the overview image.
DISCOVERY_CONTEXT_MARGIN_M=60

# Approximate real-world spacing between positive SAM prompts during rough discovery.
DISCOVERY_PROMPT_SPACING_M=90
DISCOVERY_MIN_PROMPT_SPACING_PX=28

# Minimum SAM confidence for a rough whole-area field candidate.
DISCOVERY_MIN_SAM_SCORE=0.55

# Stage 2 downloads a fresh close-up image around every rough field candidate.
REFINEMENT_IMAGE_WIDTH=1000
REFINEMENT_IMAGE_HEIGHT=1000

# Desired close-up ground resolution. If the field will not fit at this resolution,
# the code automatically zooms out just enough to include the field and its margin.
REFINEMENT_MPP=0.35

# Context around each rough field before downloading its dedicated close-up image.
# The larger of this fraction of field size and REFINEMENT_MIN_MARGIN_M is used.
REFINEMENT_MARGIN_FRACTION=0.20
REFINEMENT_MIN_MARGIN_M=35

# Padding around the rough Stage-1 bounding box supplied to SAM in Stage 2.
REFINEMENT_BOX_PADDING_M=10
REFINEMENT_MIN_SAM_SCORE=0.55

# A refined mask must cover at least this fraction of the rough Stage-1 field.
REFINEMENT_MIN_ROUGH_OVERLAP=0.45

# Smallest/largest final field candidates accepted by the scanner.
FIELD_MIN_AREA_HA=0.35
FIELD_MAX_AREA_HA=250

# Loose area bounds used only during Stage-1 rough mask selection.
DISCOVERY_PREFILTER_MIN_AREA_RATIO=0.50
DISCOVERY_PREFILTER_MAX_AREA_RATIO=1.50

# Minimum fraction of a rough detection that must overlap the farmer's search box.
FIELD_DISCOVERY_MIN_AREA_OVERLAP=0.35

# Intersection-over-union above which rough detections are treated as duplicates.
FIELD_DEDUP_IOU=0.55

# Moderate simplification applied only after the high-resolution refinement pass.
REFINEMENT_SIMPLIFY_M=2.0
REFINEMENT_MAX_VERTICES=45
REFINEMENT_MIN_VERTICES=8
REFINEMENT_MIN_SIMPLIFY_M=0.5
REFINEMENT_SIMPLIFY_MAX_ITERATIONS=10
REFINEMENT_SIMPLIFY_GROWTH=1.35


# -----------------------------------------------------------------------------
# Tractor and normal straight-line route planning
# -----------------------------------------------------------------------------

# Key in tractor_profiles.json used for turning-radius information.
TRACTOR_PROFILE=default_tractor

# Effective working width of the implement.
IMPLEMENT_WIDTH_M=6.0

# Unworked margin reserved around the field edge for turning/headland work.
HEADLAND_WIDTH_M=1.0

# Fractional overlap between adjacent straight passes.
OVERLAP=0.02

# Angle increment tested by the normal straight-line route planner.
# Smaller values search more headings but take longer.
ANGLE_STEP_DEG=2

# Assumed tractor speed while working a pass.
WORKING_SPEED_MPS=2.5

# Assumed tractor speed while moving between passes.
TURNING_SPEED_MPS=1.5

# Fixed time penalty added for every turn between passes.
FIXED_TURN_TIME_S=2


# -----------------------------------------------------------------------------
# Terrain and terrain-aware routing
# -----------------------------------------------------------------------------

# If true, route generation may download terrain when it has not been saved yet.
AUTO_FETCH_TERRAIN=true

# Mapbox Terrain-RGB tile zoom. Mapbox terrain data currently tops out at zoom 14.
TERRAIN_TILE_ZOOM=14

# Number of terrain samples along the longest side of the satellite image.
# Larger grids preserve more terrain detail but use more memory/CPU.
TERRAIN_GRID_SIZE=300

# Vertical elevation interval between contour lines in the terrain overlay.
CONTOUR_INTERVAL_M=2.0

# If the field's 90th-percentile slope reaches this value, use terrain-aware routing.
CONTOUR_SLOPE_THRESHOLD_DEG=5.0

# HTTP timeout for Terrain-RGB tile downloads.
TERRAIN_REQUEST_TIMEOUT=30

# Angle increment tested by the straight contour-aware route planner.
CONTOUR_STRAIGHT_ANGLE_STEP_DEG=1.0

# Strength of the terrain-alignment penalty relative to route time.
# Higher values favour following equal-elevation direction more strongly.
CONTOUR_ALIGNMENT_WEIGHT=8.0

# Ignore DEM cells flatter than this when estimating reliable contour direction.
CONTOUR_DIRECTION_MIN_SLOPE_DEG=1.0

# Extra pass overlap used only on contour-aware routes.
CONTOUR_EXTRA_OVERLAP=0.08

# DPI used when rendering terrain_overlay.png.
TERRAIN_OVERLAY_DPI=100

# Line width of elevation contours in terrain_overlay.png.
TERRAIN_OVERLAY_CONTOUR_LINE_WIDTH=1.2

# Font size of elevation labels in terrain_overlay.png.
TERRAIN_OVERLAY_LABEL_FONT_SIZE=7

# Line width of the field boundary in terrain_overlay.png.
TERRAIN_OVERLAY_BOUNDARY_LINE_WIDTH=2


# -----------------------------------------------------------------------------
# OpenCV overlay appearance
# -----------------------------------------------------------------------------
# Colours below are B,G,R because OpenCV uses BGR rather than RGB.

# Single-field detected boundary colour.
DETECTED_BOUNDARY_COLOUR_BGR=0,0,255

# Single-field detected boundary line thickness.
DETECTED_BOUNDARY_LINE_THICKNESS_PX=4

# GPS/centre marker colour on the single-field detection overlay.
GPS_MARKER_COLOUR_BGR=0,255,0

# GPS/centre marker radius.
GPS_MARKER_RADIUS_PX=7

# Candidate field outline colour during whole-farm review.
CANDIDATE_BOUNDARY_COLOUR_BGR=0,255,0

# Candidate field outline thickness during whole-farm review.
CANDIDATE_BOUNDARY_LINE_THICKNESS_PX=4

# Actual field boundary colour on route overlays.
ROUTE_FIELD_COLOUR_BGR=0,255,0

# Actual field boundary line thickness on route overlays.
ROUTE_FIELD_LINE_THICKNESS_PX=3

# Inner working/headland boundary colour on route overlays.
ROUTE_WORKING_AREA_COLOUR_BGR=0,215,255

# Inner working/headland boundary line thickness.
ROUTE_WORKING_AREA_LINE_THICKNESS_PX=2

# Working-pass colour on route overlays.
ROUTE_SWATH_COLOUR_BGR=255,0,0

# Working-pass line thickness.
ROUTE_SWATH_LINE_THICKNESS_PX=2

# Route-order connector colour. These are not yet steering-constrained turns.
ROUTE_CONNECTOR_COLOUR_BGR=255,255,255

# Route-order connector line thickness.
ROUTE_CONNECTOR_LINE_THICKNESS_PX=1

# Start-of-pass marker colour.
ROUTE_START_MARKER_COLOUR_BGR=255,255,255

# Start-of-pass marker radius.
ROUTE_START_MARKER_RADIUS_PX=3

# Label the first pass and then every Nth pass.
ROUTE_LABEL_EVERY_N_PASSES=5

# OpenCV font scale used for pass-number labels.
ROUTE_LABEL_FONT_SCALE=0.4

# Pass-number label line thickness.
ROUTE_LABEL_LINE_THICKNESS_PX=1

# Horizontal pixel offset of pass-number labels from the pass start marker.
ROUTE_LABEL_OFFSET_X_PX=4

# Vertical pixel offset of pass-number labels from the pass start marker.
ROUTE_LABEL_OFFSET_Y_PX=-4


# -----------------------------------------------------------------------------
# Local Flask UI
# -----------------------------------------------------------------------------

# Local address the Flask server binds to.
GPS_TRACTOR_UI_HOST=127.0.0.1

# Local port used by the Flask UI.
GPS_TRACTOR_UI_PORT=5000

# If true, automatically open the UI in the default browser after startup.
GPS_TRACTOR_OPEN_BROWSER=true

# Delay before opening the browser, giving Flask time to start listening.
GPS_TRACTOR_BROWSER_OPEN_DELAY_S=1.0
