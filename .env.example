# Mapbox
MAPBOX_TOKEN=pk.your_token_here
MAP_ZOOM=14
IMAGE_WIDTH=1000
IMAGE_HEIGHT=1000

# GPS: use mock until the receiver is fitted
GPS_MODE=mock
MOCK_LAT=55.843089
MOCK_LON=-3.102406
GPS_PORT=/dev/serial0
GPS_BAUD=115200
GPS_SAMPLES=5
GPS_TIMEOUT=300
GPS_ALLOW_FLOAT=false

# Image confirmation window
REVIEW_IMAGE=true

# Field detection
SAM_MODEL=facebook/sam2.1-hiera-tiny

# Tractor / route
TRACTOR_PROFILE=default_tractor
IMPLEMENT_WIDTH_M=6.0
HEADLAND_WIDTH_M=10.0
OVERLAP=0.02
ANGLE_STEP_DEG=2
WORKING_SPEED_MPS=2.5
TURNING_SPEED_MPS=1.5
FIXED_TURN_TIME_S=2
